<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dquinonezS5.Views.vPersona"
             Title="vPersona">
    <ScrollView>
    <VerticalStackLayout
        Padding="25"
        Spacing="25">
        <Label 
            Text="Semana 5: SQLITE"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry x:Name="txtNombre"
               Placeholder="Ingresa el nombre"
               >
            
        </Entry>

        <Grid Padding="5" RowSpacing="1" ColumnSpacing="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAgregar"
                    Text="Agregar persona"
                    Clicked="btnAgregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"
                    >
                
            </Button>
            <Label x:Name="lblMessage"
                   TextColor="Red"
                   Grid.Row="1"
                   Grid.Column="0"
                   >
                
            </Label>

            <Button x:Name="btnMostrar"
                    Text="Mostrar personas"
                    Clicked="btnMostrar_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"
                    >

            </Button>

            <CollectionView x:Name="listaPersonas"
                            Grid.Row="3"
                            Grid.Column="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   >
                                
                            </Label>
                            <Label Text="{Binding Name}"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   >

                            </Label>

                            <Button x:Name="btnEditar"
                                    Text="Editar"
                                    Clicked="btnEditar_Clicked"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    
                                    >   

                            </Button>
                            <Button x:Name="btnEliminar"
                                    Text="Eliminar"
                                    Clicked="btnEliminar_Clicked"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    >

                            </Button>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>